	  <!--体检API服务监听地址（HttpListener前缀），+ 表示监听本机所有IP；端口可改-->
	  <add name="ApiListenPrefix" connectionString="http://+:8090/"/>	  
    <!--体检待撤销费用Sql语句-->
    <add name="CancelFeeSql" connectionString="SELECT 1 来源,RegisterID 体检号,ChargeNo HIS流水号 FROM TJRegisters WHERE ChargeNo IS NOT NULL and FeeState = 2 And ReqDate &gt; getdate() - 3
													 UNION ALL
													SELECT 2 来源,RegisterID 体检号,ChargeNo HIS流水号 FROM TJRegistersAddFee WHERE ChargeNo IS NOT NULL and FeeState = 2 And ReqDate &gt; getdate() - 3"/>

    <!--体检待同步费用Sql语句-->
    <!--<add name="SendFeeSql" connectionString="Select 1 来源,registerID 流水号,registerID 体检号,Name 姓名,IdCard 身份证号,Tel 联系电话,Amt 金额
													 From TJRegisters 
													Where Amt &gt; 0 And FeeState = 0 And IsSend = 1 And ReqDate &gt; getdate() - 3
												   Union All
												   Select 2 来源,ID 流水号,registerID 体检号,Name 姓名,IdCard 身份证号,Tel 联系电话,Amt 金额
													 From TJRegistersAddFee 
													Where Amt &gt; 0 And FeeState = 0 And IsSend = 1 And ReqDate &gt; getdate() - 3"/>-->
    
    <add name="SendFeeSql" connectionString="Select 1 来源,registerID 流水号,Gender 性别,registerID 体检号,Name 姓名,CASE  
													WHEN IdCard  like 'Y%'   then  ''
													else IdCard end as 身份证号,Tel 联系电话,Amt 金额
													 From TJRegisters 
													Where Amt &gt; 0 And FeeState = 0 And IsSend = 1 And ReqDate &gt; getdate() - 3
												   Union All
												   Select 2 来源,ID 流水号,'' 性别, registerID 体检号,Name 姓名,CASE  
													WHEN IdCard  like 'Y%'   then  ''
													else IdCard end as 身份证号,Tel 联系电话,Amt 金额
													 From TJRegistersAddFee 
													Where Amt &gt; 0 And FeeState = 0 And IsSend = 1 And ReqDate &gt; getdate() - 3"/>
  
    <!--PACS取消申请Sql语句-->
    <add name="PacsCancelSql" connectionString="SELECT a.RegisterID 体检号,b.Reqno 申请单号,b.IsSend 状态
													  FROM TJRegisters a,PacApply b
													 WHERE b.IsSend IN (1,2) AND b.CardID = a.RegisterID AND a.FeeState = 3 AND a.ReqDate &gt; getdate() - 3
                union all
     select b.CardID 体检号, b.Reqno 申请单号,b.IsSend 状态 from PacApply b
 WHERE b.IsSend IN (1,2)   and isvaild='-1'AND b.Indate  &gt;  getdate() - 1                          
    "/>
    <!--PACS申请Sql语句-->
    <add name="PacsApplySql" connectionString="Select TEL 手机号,a.REQNO 申请单号,a.CARDID 体检号,a.NAME 姓名,a.GENDER 性别,CONVERT(varchar(100), a.BIRTHDAY, 23) 出生日期,a.IDENTITYID 身份证号,
														   CASE PicDetail WHEN 'CC' THEN 'US' ELSE PicDetail END AS 类型,
														   a.InDate as 开单时间,a.DoctorID 医生工号,a.DoctorName 医生姓名,b.ItemName 项目名称,a.BodyPart 项目ID
													  From PacApply a,PacApplyCheckFee b
													 Where   b.ReqNo = a.ReqNo and  a.PicDetail !='XD' And a.IsSend =1 And a.Indate &gt; Getdate() - 3"/>
    <!--查询需要下载结果的PACS申请Sql语句-->
    <add name="PacsResultSql" connectionString="SELECT b.Reqno 申请单号,a.SeqNo 序号
													  FROM PacApply b,PacApplyCheckfee a
													 WHERE a.ReqNo = b.ReqNo And b.IsSend = 2 and b.InDate &gt; getdate() - 10"/>
    <!--LIS申请撤销Sql语句-->
    <add name="LisCancelSql" connectionString="SELECT a.RegisterID 体检号,b.Reqno 申请单号,b.State 状态,CONVERT(varchar(100), a.ReqDate, 25) 操作时间,b.REQDOCTOR 操作医生,b.REQDOCTORID 操作医生ID
													FROM TJRegisters a,labreqmaster b
													WHERE b.State IN (1,3) AND b.PATNO = a.RegisterID And a.FeeState in (3,4) AND a.ReqDate &gt; getdate() - 3"/>
    <!--LIS申请Sql语句-->
    <add name="LisApplySql" connectionString="Select a.REQNO 申请单号,a.PATNO 体检号,a.PATNAME 姓名,CASE a.SEX WHEN '男' THEN 1 ELSE 2 END AS 性别,CONVERT(varchar(100), a.BIRTHDAY, 23) 出生日期,
														   a.INSURE_ID 身份证号,a.PHONE 联系电话,b.ITEMNAME 项目名称,b.ITEMCODE 项目代码,a.REQDOCTOR 开单医生,a.REQDOCTORID 开单医生ID,b.BarCode 样本条码,
														   CONVERT(varchar(100), GETDATE(), 25) 开单时间,CONVERT(varchar(100), a.REQDATE, 23) 申请时间
													  From LABREQMASTER a,LABREQITEM b
													 Where b.State = 0  And a.State = 1 AND b.ReqNo = a.ReqNo  And a.Reqdate &gt; Getdate() - 3 Order By a.PatNO,b.BarCode"/>
    <!--查询需要下载结果的LIS申请Sql-->
    <add name="LisResultSql" connectionString="Select binganhao 体检号,tiaomahao 样本条码, shenqingdanid 申请单号, to_char(kaidansj,'yyyy-mm-dd') 申请时间, jianyanxmdm 项目代码,
                                           bingrenid 患者ID, xingming 患者姓名, xingbie 性别代码, decode(xingbie,'1','男','2','女') 性别名称,
                                           shenfenZH 证件号, to_char(chushengrq,'yyyymmdd') 出生日期, nianling 年龄
                                            From Lcb_Jianyansqd
                                            Where jiuzhenlx=3 And JIANYANZT>=150 And nvl(DAOCHUBZ,0)=0 and tiaomahao In('26072900382')And xiugaisj &gt; sysdate-1"/>
	  <!--查询需要重新回传结果的LIS（二次审核，从LIS库Lcb_Jianyansqd查，DAOCHUBZ=1已回传过）
         去重：Lcb_Jianyansqd.ERCISHJ 存上次重传时间，仅当LCB_YANGBENXXQXSHJL中存在新于该时间的审核记录才重传
         需先手工执行：ALTER TABLE Lcb_Jianyansqd ADD ERCISHJ DATE;
         注：患者列名、LCB审核时间列名(SHENHESJ)为推测值，请根据实际列名调整-->
    <add name="LisResultAgainSql" connectionString="Select binganhao 体检号, tiaomahao 样本条码, shenqingdanid 申请单号, to_char(kaidansj,'yyyy-mm-dd') 申请时间, jianyanxmdm 项目代码,
       bingrenid 患者ID, xingming 患者姓名, xingbie 性别代码, decode(xingbie,'1','男','2','女') 性别名称,
       shenfenZH 证件号, to_char(chushengrq,'yyyymmdd') 出生日期, nianling 年龄
  From Lcb_Jianyansqd t
 Where t.jiuzhenlx=3 And t.JIANYANZT>=150  And nvl(t.DAOCHUBZ,0)=1 
 --And  tiaomahao= '26072300582'
   And t.xiugaisj > sysdate-1
   And exists (
       select 1 from LCB_YANGBENXXQXSHJL l
        where l.tiaomahao = t.tiaomahao 
          and l.xiugaisj > nvl(t.ERCISHJ, t.jiancesj)
   )"/>  
    <!--END-->
