    <!--PACS查询结果Sql-->
    <add name="GetPacsResultSql" connectionString="Select a.orderseq,(Select Distinct patientid From t_hisorder Where HIS_Id=a.his_id)  病人id,a.PHYSICALEXAMID 体检号, a.Modality 检查方式编码,a.his_id 申请单号,(Select Distinct VISITNUM1 From t_hisorder Where HIS_Id=a.his_id) 电子申请单号,
(Select EXAMITEMCODE From t_examitem WHERE  examitemId=A.examitemId) examitemId,a.ModalityID 报告ID,
Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性') 检查结果,B.DIAGRESULT 诊断意见, B.REPORTDT 检查时间,
													   B.REPORTDR 检查人ID, B.REPORTDR 检查人,B.VERIFYDT 审核时间, B.VERIFYDR 审核人ID,B.VERIFYDR 审核人, B.STUDYRESULT 检查所见,
													   listagg(distinct c.PDFPATH,';') within group(order by c.PDFPATH) 报告图片
												  From t_Order A，t_Report b，t_Pdfconvertrecord c,t_report_queue d
												 Where C.REPORTSEQ = B.REPORTSEQ And b.reportseq = a.reportseq And a.OrderStatus In ('1170','1180') And a.modality   In ('US','ES') 
                           And A.his_id Is Not Null  And a.Pattype = 'P' And a.orderseq = d.orderid 
                           And Nvl(d.tj_report_flag,'N') = 'N'
                            And d.worktime > Trunc(Sysdate) -7
                          And a.PHYSICALEXAMID='P2607230018'
												 Group By a.orderseq,a.PHYSICALEXAMID,a.Modality,a.his_id,examitemId,a.ModalityID,Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性'),B.DIAGRESULT,B.REPORTDT,B.REPORTDR,B.VERIFYDT,B.VERIFYDR,B.STUDYRESULT                        
Union All
Select a.orderseq,(Select Distinct patientid From t_hisorder Where HIS_Id=a.his_id)  病人id,a.PHYSICALEXAMID 体检号, a.Modality 检查方式编码, a.his_id 申请单号,(Select Distinct VISITNUM1 From t_hisorder Where HIS_Id=a.his_id) 电子申请单号,
(Select EXAMITEMCODE From t_examitem WHERE  examitemId=A.examitemId) examitemId,a.ModalityID 报告ID,
Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性') 检查结果,B.DIAGRESULT 诊断意见, B.REPORTDT 检查时间,
													   B.REPORTDR 检查人ID, B.REPORTDR 检查人,B.VERIFYDT 审核时间, B.VERIFYDR 审核人ID,B.VERIFYDR 审核人, B.STUDYRESULT 检查所见,
													listagg(distinct c.PDFPATH,';') within group(order by c.PDFPATH) 报告图片 
												  From t_Order A，t_Report b，t_Pdfconvertrecord c,t_report_queue d
												 Where C.REPORTSEQ = B.REPORTSEQ And b.reportseq = a.reportseq And a.OrderStatus In ('1170','1180') And a.modality  Not In ('US','ES')  
                         And a.PHYSICALEXAMID='P2607230018'
                           And A.his_id Is Not Null  And a.Pattype = 'P'And a.orderseq = d.orderid And Nvl(d.tj_report_flag,'N') = 'N' And d.worktime> Trunc(Sysdate) -7
												 Group By a.orderseq,a.PHYSICALEXAMID,a.Modality,a.his_id,examitemId,a.ModalityID,Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性'),B.DIAGRESULT,B.REPORTDT,B.REPORTDR,B.VERIFYDT,B.VERIFYDR,B.STUDYRESULT
                                                
                         "/>
    
    
    <add name="GetPacsResultSqlAgain" connectionString="
Select a.orderseq,(Select Distinct patientid From t_hisorder Where HIS_Id=a.his_id)  病人id,a.PHYSICALEXAMID 体检号, a.Modality 检查方式编码,a.his_id 申请单号,(Select Distinct VISITNUM1 From t_hisorder Where HIS_Id=a.his_id) 电子申请单号,
(Select EXAMITEMCODE From t_examitem WHERE  examitemId=A.examitemId) examitemId,a.ModalityID 报告ID,
Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性') 检查结果,B.DIAGRESULT 诊断意见, B.REPORTDT 检查时间,
													   B.REPORTDR 检查人ID, B.REPORTDR 检查人,B.VERIFYDT 审核时间, B.VERIFYDR 审核人ID,B.VERIFYDR 审核人, B.STUDYRESULT 检查所见,
													   listagg(distinct c.PDFPATH,';') within group(order by c.PDFPATH) 报告图片
												  From t_Order A，t_Report b，t_Pdfconvertrecord c,t_report_queue d
												 Where C.REPORTSEQ = B.REPORTSEQ and B.VERIFYDT!=B.FIRSTVERIFYDT And b.reportseq = a.reportseq And a.OrderStatus In ('1170','1180') And a.modality   In ('US','ES') 
                           And A.his_id Is Not Null  And a.Pattype = 'P' And a.orderseq = d.orderid 
                           And Nvl(d.tj_report_flag,'N') = 'N'
                            And d.worktime > Trunc(Sysdate) -1
                          And a.PHYSICALEXAMID='P2607230018'
					Group By a.orderseq,a.PHYSICALEXAMID,a.Modality,a.his_id,examitemId,a.ModalityID,Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性'),B.DIAGRESULT,B.REPORTDT,B.REPORTDR,B.VERIFYDT,B.VERIFYDR,B.STUDYRESULT                        
Union All
Select a.orderseq,(Select Distinct patientid From t_hisorder Where HIS_Id=a.his_id)  病人id,a.PHYSICALEXAMID 体检号, a.Modality 检查方式编码, a.his_id 申请单号,(Select Distinct VISITNUM1 From t_hisorder Where HIS_Id=a.his_id) 电子申请单号,
(Select EXAMITEMCODE From t_examitem WHERE  examitemId=A.examitemId) examitemId,a.ModalityID 报告ID,
Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性') 检查结果,B.DIAGRESULT 诊断意见, B.REPORTDT 检查时间,
													   B.REPORTDR 检查人ID, B.REPORTDR 检查人,B.VERIFYDT 审核时间, B.VERIFYDR 审核人ID,B.VERIFYDR 审核人, B.STUDYRESULT 检查所见,
													listagg(distinct c.PDFPATH,';') within group(order by c.PDFPATH) 报告图片 
												  From t_Order A，t_Report b，t_Pdfconvertrecord c,t_report_queue d
												 Where C.REPORTSEQ = B.REPORTSEQ And b.reportseq = a.reportseq And a.OrderStatus In ('1170','1180') And a.modality  Not In ('US','ES')  
                         And a.PHYSICALEXAMID='P2607230018'
                           And B.VERIFYDT!=B.FIRSTVERIFYDT and A.his_id Is Not Null  And a.Pattype = 'P'And a.orderseq = d.orderid And Nvl(d.tj_report_flag,'N') = 'N' And d.worktime> Trunc(Sysdate) -1
						Group By a.orderseq,a.PHYSICALEXAMID,a.Modality,a.his_id,examitemId,a.ModalityID,Decode（B.ABNORMAL,0,'阴性' ,1,'阳性'，'阴性'),B.DIAGRESULT,B.REPORTDT,B.REPORTDR,B.VERIFYDT,B.VERIFYDR,B.STUDYRESULT
           		 "/>
    
        
    
    <!--End-->
